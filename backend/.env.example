# Backend Configuration
DATABASE_URL=sqlite:///./insightflow.db
UPLOAD_DIR=uploads

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# AI Provider Configuration
# Choose between: openai, gemini, groq, or auto (default)
AI_PROVIDER=auto
AI_MODEL=

# API Keys (Do not commit real keys!)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# SMTP Email Configuration (Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
FRONTEND_URL=https://insight-flow-automated-business-int.vercel.app
